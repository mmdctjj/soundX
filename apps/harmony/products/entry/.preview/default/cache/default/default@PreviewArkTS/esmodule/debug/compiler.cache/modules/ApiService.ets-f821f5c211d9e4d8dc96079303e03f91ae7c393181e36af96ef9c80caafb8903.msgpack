  }
  if (params['sortBy']) {
    queryParams['sortBy'] = params['sortBy'];
  }
  return httpClient.get('/api/tracks' + buildQueryString(queryParams));
}

export async function getCollections(userId: number | string): Promise<Object> {
  return httpClient.get('/api/users/' + userId + '/collections');
}

export async function getPlaylists(type: string, userId: number | string): Promise<Object> {
  return httpClient.get('/api/playlists?type=' + type + '&userId=' + userId);
}

export async function getFavoriteTracks(userId: number | string, skip: number, pageSize: number, type: string): Promise<Object> {
  return httpClient.get('/api/users/' + userId + '/favorites/tracks?skip=' + skip + '&pageSize=' + pageSize + '&type=' + type);
}

export async function getFavoriteAlbums(userId: number | string, skip: number, pageSize: number, type: string): Promise<Object> {
  return httpClient.get('/api/users/' + userId + '/favorites/albums?skip=' + skip + '&pageSize=' + pageSize + '&type=' + type);
}

export async function getTrackHistory(userId: number | string, skip: number, pageSize: number, type: string): Promise<Object> {
  return httpClient.get('/api/users/' + userId + '/history/tracks?skip=' + skip + '&pageSize=' + pageSize + '&type=' + type);
}

export async function getMvList(pageSize: number, skip: number): Promise<Object> {
  return httpClient.get('/api/mvs?pageSize=' + pageSize + '&skip=' + skip);
}

// ============ ç½‘ç»œå·¥å…· ============
export async function checkServerConnectivity(address: string, sourceType: string): Promise<boolean> {
  if (!address) {
    return false;
  }
  if (!address.startsWith('http://') && !address.startsWith('https://')) {
    return false;
  }

  const mappedType = SOURCEMAP[sourceType] || 'audiodock';

  let pingUrl: string;
  if (mappedType === 'subsonic') {
    pingUrl = address.replace(/\/+$/, '') + '/rest/ping.view?v=1.16.1&c=SoundX&f=json';
  } else if (mappedType === 'emby') {
    pingUrl = address.replace(/\/+$/, '') + '/emby/System/Info/Public';
  } else {
    pingUrl = address.replace(/\/+$/, '') + '/hello';
  }

  const httpRequest = http.createHttp();
  let response: http.HttpResponse;

  try {
    response = await new Promise<http.HttpResponse>((resolve, reject) => {
      httpRequest.request(
        pingUrl,
        {
          method: http.RequestMethod.GET,
          readTimeout: 3000,
          connectTimeout: 3000
        },
        (err, data) => {
          if (err) {
            reject(err);
          } else {
            resolve(data);
          }
        }
      );
    });
  } catch (error) {
    httpRequest.destroy();
    return false;
  }

  httpRequest.destroy();

  if (response.responseCode >= 200 && response.responseCode < 300) {
    return true;
  }
  if (mappedType === 'subsonic' && response.responseCode === 401) {
    return true;
  }
  return false;
}

export async function selectBestServer(
  internalAddress: string,
  externalAddress: string,
  sourceType: string
): Promise<string | null> {
  if (externalAddress) {
    const externalAlive = await checkServerConnectivity(externalAddress, sourceType);
    if (externalAlive) {
      return externalAddress;
    }
  }
  if (internalAddress) {
    const internalAlive = await checkServerConnectivity(internalAddress, sourceType);
    if (internalAlive) {
      return internalAddress;
    }
  }
  return null;
}
