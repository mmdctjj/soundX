  build() {
    if (this.loading && !this.refreshing) {
      this.LoadingSkeleton();
    } else {
      Column() {
        Row() {
          Text('AudioDock')
            .fontSize(24)
            .fontWeight(FontWeight.Bold)
            .fontColor('#2c3e50')

          Row() {
            if (this.mode === 'MUSIC') {
              Button() {
                Text(this.isRadioMode ? 'ğŸ“»' : 'â­•')
                  .fontSize(18)
              }
              .width(36)
              .height(36)
              .backgroundColor(this.isRadioMode ? '#007DFF20' : '#f0f0f0')
              .borderRadius(18)
              .margin({ right: 8 })
              .borderWidth(this.isRadioMode ? 1 : 0)
              .borderColor('#007DFF40')
              .onClick(() => this.toggleRadioMode())
            }

            Button() {
              Text(this.mode === 'MUSIC' ? 'ğŸµ' : 'ğŸ§')
                .fontSize(18)
            }
            .width(36)
            .height(36)
            .backgroundColor('#f0f0f0')
            .borderRadius(18)
            .onClick(() => this.toggleMode())
          }
        }
        .width('100%')
        .padding({ left: 16, right: 16, top: 16, bottom: 8 })
        .justifyContent(FlexAlign.SpaceBetween)

        Row() {
          Text('ğŸ” æœç´¢éŸ³ä¹ã€ä¸“è¾‘ã€è‰ºäºº...')
            .fontSize(14)
            .fontColor('#95a5a6')
        }
        .width('100%')
        .height(44)
        .padding({ left: 16, right: 16 })
        .margin({ left: 16, right: 16 })
        .backgroundColor('#f8f9fa')
        .borderRadius(10)
        .onClick(() => this.navigateToSearch())

        List() {
          ForEach(this.sections, (section: Section) => {
            ListItem() {
              Column() {
                this.SectionHeader(section.title, section.id)

                Scroll() {
                  Row() {
                    if (section.type === 'artist') {
                      ForEach(section.data as Artist[], (item: Artist) => {
                        this.ArtistCard(item);
                      })
                    } else if (section.type === 'album') {
                      ForEach(section.data as Album[], (item: Album) => {
                        this.AlbumCard(item, section.id === 'history');
                      })
                    } else if (section.type === 'track') {
                      Row() {
                        ForEach(this.chunkTracks(section.data as Track[]), (chunk: Track[]) => {
                          Column() {
                            ForEach(chunk, (track: Track) => {
                              this.TrackCard(track);
                            })
                          }
                        })
                      }
                    }
                  }
                  .padding({ left: 16, right: 16 })
                }
                .scrollBar(BarState.Off)
                .scrollable(ScrollDirection.Horizontal)
              }
              .width('100%')
              .alignItems(HorizontalAlign.Start)
            }
          })

          ListItem() {
            Row() {
              Text('âš™ï¸')
                .fontSize(16)
                .margin({ right: 8 })

              Text('è°ƒæ•´æ¿å—é¡ºåº')
                .fontSize(14)
                .fontColor('#007DFF')
            }
            .width('100%')
            .padding(20)
            .justifyContent(FlexAlign.Center)
          }
        }
        .width('100%')
        .layoutWeight(1)
        .scrollBar(BarState.Off)
        .edgeEffect(EdgeEffect.Spring)
        .onScrollIndex((first: number) => {
          // Scroll event
        })
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#ffffff')
    }
  }

  chunkTracks(tracks: Track[]): Track[][] {
    const result: Track[][] = [];
    for (let i = 0; i < tracks.length; i += 2) {
      const chunk: Track[] = [];
      chunk.push(tracks[i]);
      if (i + 1 < tracks.length) {
        chunk.push(tracks[i + 1]);
      }
      result.push(chunk);
    }
    return result;
  }

  @Builder
  LoadingSkeleton() {
    Column() {
      Row() {
        Row()
          .width(100)
          .height(28)
          .borderRadius(8)
          .backgroundColor('#e8e8e8')

        Row()
          .width(80)
          .height(36)
          .borderRadius(18)
          .backgroundColor('#e8e8e8')
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 20 })
      .justifyContent(FlexAlign.SpaceBetween)

      Row()
        .width('90%')
        .height(44)
        .borderRadius(10)
        .backgroundColor('#e8e8e8')
        .margin({ left: 16, right: 16, top: 16 })

      ForEach([1, 2, 3], (index: number) => {
        Column() {
          Row()
            .width(120)
            .height(24)
            .borderRadius(8)
            .backgroundColor('#e8e8e8')
            .margin({ left: 16, bottom: 12 })

          Row() {
            ForEach([1, 2, 3, 4], (i: number) => {
              Column() {
                Row()
                  .width(i === 1 ? 80 : 100)
                  .height(i === 1 ? 80 : 100)
                  .borderRadius(i === 1 ? 40 : 8)
                  .backgroundColor('#e8e8e8')
                  .margin({ bottom: 8 })

                Row()
                  .width(60)
                  .height(14)
                  .borderRadius(4)
                  .backgroundColor('#e8e8e8')
              }
              .margin({ right: 16 })
            })
          }
          .padding({ left: 16 })
        }
        .margin({ top: 16 })
        .alignItems(HorizontalAlign.Start)
      })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#ffffff')
  }
}
