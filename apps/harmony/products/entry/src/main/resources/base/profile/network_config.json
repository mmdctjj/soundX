{
  "network-security-config": {
    "base-config": {
      "trust-anchors": [
        {
          "certificates": "system"
        }
      ],
      "cleartextTrafficPermitted": true
    },
    "domain-config": [
      {
        "domains": [
          {
            "include-subdomains": true,
            "name": "localhost"
          },
          {
            "include-subdomains": true,
            "name": "127.0.0.1"
          },
          {
            "include-subdomains": true,
            "name": "10.0.0.0"
          },
          {
            "include-subdomains": true,
            "name": "192.168.0.0"
          }
        ],
        "trust-anchors": [
          {
            "certificates": "system"
          }
        ],
        "cleartextTrafficPermitted": true
      }
    ]
  }
}