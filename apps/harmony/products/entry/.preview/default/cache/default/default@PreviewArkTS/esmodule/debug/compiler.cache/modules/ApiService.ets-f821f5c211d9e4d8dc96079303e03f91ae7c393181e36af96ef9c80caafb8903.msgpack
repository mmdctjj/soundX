function buildQueryString(params) {
    const pairs = [];
    const keys = Object.keys(params);
    for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        const value = params[key];
        if (value && value.length > 0) {
            pairs.push(key + '=' + encodeURIComponent(value));
        }
    }
    if (pairs.length > 0) {
        return '?' + pairs.join('&');
    }
    return '';
}
