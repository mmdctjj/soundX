# 小米小爱音箱音乐服务配置
# 复制此文件为 .env 并填入实际值

# ====== 小米账号配置 ======
MI_USERNAME=your_mi_account
MI_PASSWORD=your_mi_password

# ====== 本地音乐目录 ======
# 扫描该目录下的音频文件，支持 mp3, flac, wav, m4a, ogg
MUSIC_DIR=~/Music

# ====== HTTP 服务配置 ======
# HTTP_HOST 必须是音箱在局域网能访问到的 IP（不能是 127.0.0.1）
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# ====== 语音指令前缀 ======
# 只有以此前缀开头的语音指令才会被处理
COMMAND_PREFIX=本地播放

# ====== 语音抢答关键词 ======
# 对小爱说「{关键词} 歌名」，命中后从本地音乐库匹配并推 URL 给音箱
# 多个关键词用英文逗号分隔，按最长匹配优先
# 默认: 本地播放,播放声仓,声仓
VOICE_KEYWORDS=本地播放,播放声仓,声仓

# ====== 对话记录轮询间隔（秒） ======
# userprofile API 频率限制较宽松，1s 即可；网络差可调大
PULL_ASK_INTERVAL_SEC=1

# ====== 日志级别 ======
LOG_LEVEL=INFO
