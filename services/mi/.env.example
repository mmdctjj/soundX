# 小米小爱音箱音乐服务配置
# 复制此文件为 .env 并填入实际值

# ====== 小米账号配置 ======
MI_USERNAME=your_mi_account
MI_PASSWORD=your_mi_password

# ====== 本地音乐目录 ======
# 扫描该目录下的音频文件，支持 mp3, flac, wav, m4a, ogg
MUSIC_DIR=~/Music

# ====== HTTP 服务配置 ======
# HTTP_HOST 必须是音箱在局域网能访问到的 IP（不能是 127.0.0.1）
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# ====== 语音指令前缀 ======
# 只有以此前缀开头的语音指令才会被处理
COMMAND_PREFIX=本地播放

# ====== 日志级别 ======
LOG_LEVEL=INFO
