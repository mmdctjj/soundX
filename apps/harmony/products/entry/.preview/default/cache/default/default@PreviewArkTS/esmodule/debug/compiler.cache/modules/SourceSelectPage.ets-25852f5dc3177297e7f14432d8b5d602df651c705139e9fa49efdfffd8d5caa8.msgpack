interface SourceItem {
  key: string;
  name: string;
  desc: string;
  iconColor: string;
}

@Entry
@Component
struct SourceSelectPage {
  @State sourceList: SourceItem[] = [
    { key: 'AudioDock', name: 'AudioDock', desc: 'è‡ªå»º AudioDock æœåŠ¡ç«¯', iconColor: '#007DFF' },
    { key: 'Subsonic', name: 'Subsonic', desc: 'å…¼å®¹ Subsonic/API åè®®çš„éŸ³ä¹æœåŠ¡å™¨', iconColor: '#FF6B35' },
    { key: 'Emby', name: 'Emby', desc: 'Emby åª’ä½“æœåŠ¡å™¨', iconColor: '#52B54B' }
  ];

  @State selectedSource: string = '';

  build() {
    Column() {
      // Header
      Row() {
        Text('é€‰æ‹©æ•°æ®æº')
          .fontSize(24)
          .fontWeight(FontWeight.Bold)
          .fontColor('#2c3e50')
      }
      .width('100%')
      .padding({ top: 16, bottom: 16 })
      .justifyContent(FlexAlign.Center)

      Text('è¯·é€‰æ‹©æ‚¨çš„éŸ³ä¹æœåŠ¡å™¨ç±»åž‹')
        .fontSize(14)
        .fontColor('#95a5a6')
        .margin({ bottom: 24 })

      // Source List
      List() {
        ForEach(this.sourceList, (item: SourceItem) => {
          ListItem() {
            Row() {
              // Icon placeholder
              Column() {
                Text(item.name.substring(0, 1))
                  .fontSize(24)
                  .fontColor('#FFFFFF')
                  .fontWeight(FontWeight.Bold)
              }
              .width(50)
              .height(50)
              .borderRadius(12)
              .backgroundColor(item.iconColor)
              .justifyContent(FlexAlign.Center)

              Column() {
                Text(item.name)
                  .fontSize(18)
                  .fontWeight(FontWeight.Medium)
                  .fontColor('#2c3e50')

                Text(item.desc)
                  .fontSize(12)
                  .fontColor('#95a5a6')
                  .margin({ top: 4 })
                  .maxLines(2)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })
              }
              .layoutWeight(1)
