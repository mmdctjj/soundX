# TTS 服务本地环境变量配置
# 此文件会被 services/tts/src/main.py 自动加载（通过 python-dotenv）

# ====== 基础路径配置 ======
TXT_BASE_DIR=../api/music/txt
AUDIO_BOOK_DIR=../api/music/audio

# ====== 火山引擎 TTS 配置 ======
# TTS_VOLC_API_KEY=your_volc_api_key
# TTS_VOLC_APP_ID=your_volc_app_id

# ====== 小米 MiMo TTS 配置 ======
TTS_MIMO_API_TOKEN=sk-xxxx
TTS_MIMO_MODEL=mimo-v2.5-tts

# ====== MiniMax TTS 配置 ======
TTS_MINIMAX_API_KEY=sk-xxxx
TTS_MINIMAX_MODEL=speech-2.8-hd

