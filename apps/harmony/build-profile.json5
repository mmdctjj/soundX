{
  "app": {
    "signingConfigs": [],
    "compileSdkVersion": 5.0.0,
    "compatibleSdkVersion": 5.0.0,
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compileSdkVersion": "5.0.0",
        "compatibleSdkVersion": "5.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildOptionSet": [
      {
        "name": "release",
        "arkOptions": {
          "obfuscation": {
            "ruleOptions": {
              "enable": false,
              "files": [
                "./obfuscation-rules.txt"
              ]
            }
          }
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./products/entry"
    }
  ]
}
