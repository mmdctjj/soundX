// ============ æ•°æ®æ¨¡å‹ ============
export interface ApiResponse {
  code: number;
  data: Object | null;
  message?: string;
}

export interface User {
  id: number | string;
  username: string;
  nickname?: string;
  avatar?: string;
  role?: string;
}

export interface Artist {
  id: number | string;
  name: string;
  avatar?: string;
  cover?: string;
}

export interface Album {
  id: number | string;
  name: string;
  artist: string;
  cover?: string;
  type?: string;
  progress?: number;
  resumeTrackId?: number | string;
  resumeProgress?: number;
}

export interface Track {
  id: number | string;
  name: string;
  artist: string;
  cover?: string;
  album?: string;
  liked?: boolean;
  likedByUsers?: Array<LikeUser>;
}

export interface LikeUser {
  userId: number | string;
}

export class TrackImpl implements Track {
  id: number | string = 0;
  name: string = '';
  artist: string = '';
  cover?: string;
  album?: string;
  liked?: boolean;
  likedByUsers?: Array<LikeUser>;
}

// ============ æŸ¥è¯¢å­—ç¬¦ä¸²æ„å»º ============
function buildQueryString(params: Record<string, string>): string {
  const pairs: string[] = [];
  const keys = Object.keys(params);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = params[key];
    if (value && value.length > 0) {
      pairs.push(key + '=' + encodeURIComponent(value));
    }
  }
  if (pairs.length > 0) {
    return '?' + pairs.join('&');
  }
  return '';
}

