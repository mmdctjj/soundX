export async function checkServerConnectivity(address, sourceType) {
    if (!address) {
        return false;
    }
    if (!address.startsWith('http://') && !address.startsWith('https://')) {
        return false;
    }
    const mappedType = SOURCEMAP[sourceType] || 'audiodock';
    let pingUrl;
    if (mappedType === 'subsonic') {
        pingUrl = address.replace(/\/+$/, '') + '/rest/ping.view?v=1.16.1&c=SoundX&f=json';
    }
    else if (mappedType === 'emby') {
        pingUrl = address.replace(/\/+$/, '') + '/emby/System/Info/Public';
    }
    else {
        pingUrl = address.replace(/\/+$/, '') + '/hello';
    }
    const httpRequest = http.createHttp();
    let response;
    try {
        response = await new Promise((resolve, reject) => {
            httpRequest.request(pingUrl, {
                method: http.RequestMethod.GET,
                readTimeout: 3000,
                connectTimeout: 3000
            }, (err, data) => {
                if (err) {
                    reject(err);
                }
                else {
                    resolve(data);
                }
            });
        });
    }
    catch (error) {
        httpRequest.destroy();
        return false;
    }
    httpRequest.destroy();
    if (response.responseCode >= 200 && response.responseCode < 300) {
        return true;
    }
    if (mappedType === 'subsonic' && response.responseCode === 401) {
        return true;
    }
    return false;
}
export async function selectBestServer(internalAddress, externalAddress, sourceType) {
    if (externalAddress) {
        const externalAlive = await checkServerConnectivity(externalAddress, sourceType);
        if (externalAlive) {
            return externalAddress;
        }
    }
    if (internalAddress) {
        const internalAlive = await checkServerConnectivity(internalAddress, sourceType);
        if (internalAlive) {
            return internalAddress;
        }
    }
    return null;
}
