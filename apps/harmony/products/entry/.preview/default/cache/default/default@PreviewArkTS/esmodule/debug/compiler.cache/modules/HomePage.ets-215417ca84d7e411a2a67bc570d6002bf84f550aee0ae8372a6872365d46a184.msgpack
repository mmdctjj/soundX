    chunkTracks(tracks) {
        const result = [];
        for (let i = 0; i < tracks.length; i += 2) {
            const chunk = [];
            chunk.push(tracks[i]);
            if (i + 1 < tracks.length) {
                chunk.push(tracks[i + 1]);
            }
            result.push(chunk);
        }
        return result;
